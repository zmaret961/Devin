# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
# Leave both blank to run in on-device Demo Mode (data stays in this browser).
#
# The anon key is safe to ship in a browser app: row-level security in
# supabase/migrations decides what each signed-in user can read and write.
# NEVER put the service_role / secret key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storage bucket for manuals and insurance PDFs (created by the migration).
VITE_SUPABASE_DOCUMENTS_BUCKET=home-documents

# Show the "Sign in with Apple" button. Turn on only after the Apple provider
# is configured in Supabase (see README -> Sign in with Apple).
VITE_ENABLE_APPLE_SIGN_IN=false
