{
  "name": "devin-oncall-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A self-contained demo of an agentic on-call first responder: master triage agent, parallel child investigators, real PRs on a mock repo, and a self-improving playbook.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "demo": "vite build && tsx server/index.ts",
    "start": "tsx server/index.ts",
    "dev": "concurrently -k -n engine,web -c magenta,cyan \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "headless": "tsx server/headless.ts",
    "reset": "tsx server/reset.ts",
    "record": "tsx server/record.ts",
    "build:static": "VITE_STATIC_DEMO=1 vite build"
  },
  "dependencies": {
    "tsx": "4.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "lucide-react": "^0.460.0",
    "postcss": "^8.5.30",
    "react": "18.3",
    "react-dom": "18.3",
    "react-markdown": "^9.1.0",
    "recharts": "2.15",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "3.4",
    "typescript": "5.6",
    "vite": "^6.4.4"
  }
}
